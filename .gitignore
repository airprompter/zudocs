# Dependencies and build output
node_modules/
dist/
cdk.out/
*.tsbuildinfo

# CDK context carries the account id and lookups; pass it with --context instead
cdk.context.json

# Local configuration and anything that could hold a key
.env
.env.*
*.key.json
*.pem

# The local prompt registry for `airprompter dev` (prompt text lives in AirPrompter; seeded by npm run prompts:seed)
# and its dev root. Nothing under it but the keep file is committed: airprompter dev serves every .md there.
prompts/*
!prompts/.gitkeep
.airprompter-dev/

# Runtime state directories
state/
.airprompter/

# Editors and OS
.DS_Store
.vscode/
.idea/

# The released CLI, installed by hand (docs/PROMPTS.md); a binary never belongs in git
.bin/

# The desk app's local configuration (the deployed values, written by hand for `vite dev`; the stack writes the real one)
apps/desk/public/config.json
# Anything a local session writes beside the app for a laptop run (a signed-in session for a visual check)
apps/desk/public/dev-*.json

# Python bytecode (a py_compile check leaves it beside the worker)
__pycache__/
*.pyc

# The strip once wrote its config values here (it writes under its work directory now); never commit it
.strip.env
# The vendoring script's config values (ids and URLs), written and removed by scripts/vendor.sh; never commit it
.vendor.env
