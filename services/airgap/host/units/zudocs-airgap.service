# The Zudocs air-gapped runtime: the Agent SDK offline (no key, no base URL, no route out), hydrating from the
# datastore in the exchange bucket through the VPC's S3 gateway endpoint, filing refused observations for its
# render probes (no model is reachable here), and writing its status document back to the bucket. Runs as the
# airprompter user, who owns the store, the spool and the distribution private key (0600).
#
#   $ systemctl status zudocs-airgap
#   $ tail -f /var/log/zudocs/runtime.log

[Unit]
Description=Zudocs air-gapped runtime (AirPrompter Agent SDK, offline, hydrate from the datastore)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airprompter
Group=airprompter
EnvironmentFile=/etc/airprompter/zudocs.env
Environment=NODE_OPTIONS=--enable-source-maps
ExecStart=/usr/local/bin/node /opt/zudocs/runtime.mjs
StandardOutput=append:/var/log/zudocs/runtime.log
StandardError=append:/var/log/zudocs/runtime.log
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airprompter /var/log/zudocs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
