# airprompterd on the Zudocs eu-west host: the SDK's telemetry daemon (deploy/systemd/airprompterd.service
# at sdk-typescript/v0.3.0). It ships this host's spool and holds no release. The workers load their own.
# The identifiers come from /etc/airprompter/zudocs.env. The Agent key (upload grants only) lives in
# airprompterd.env, root:root 0600, refreshed from SSM by zudocs-agent-key before every start. The JSON log
# goes to /var/log/zudocs for the CloudWatch agent.
#
# Pinned to cli/v0.3.0 in services/eu-host/pins.json.
#
#   $ systemctl status airprompterd
#   $ journalctl -u airprompterd -n 50            # the unit's own messages; the daemon's JSON lines are in /var/log/zudocs/airprompterd.log

[Unit]
Description=AirPrompter telemetry daemon (airprompterd) for the Zudocs desk, eu-west-1
Documentation=https://github.com/airprompter/airprompter-agent-sdk/blob/sdk-typescript/v0.3.0/protocol/daemon.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airprompter
Group=airprompter
# The key file first, as root (the + prefix): a rotated parameter is picked up at the next restart. The file is
# optional to systemd (the leading -) so the start can reach ExecStartPre before it exists; when the parameter is
# not readable ExecStartPre fails, the daemon does not start, and Restart=always tries again in five seconds.
ExecStartPre=+/usr/local/sbin/zudocs-agent-key
EnvironmentFile=/etc/airprompter/zudocs.env
EnvironmentFile=-/etc/airprompter/airprompterd.env
Environment=XDG_STATE_HOME=/var/lib/airprompter
ExecStart=/usr/local/bin/airprompter daemon \
  --org ${AIRPROMPTER_ORG} \
  --agent ${AIRPROMPTER_AGENT} \
  --environment ${AIRPROMPTER_ENVIRONMENT} \
  --base-url ${AIRPROMPTER_BASE_URL} \
  --upload-interval-seconds 60 \
  --json
StandardOutput=append:/var/log/zudocs/airprompterd.log
StandardError=append:/var/log/zudocs/airprompterd.log
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the daemon needs its state directory, its log, outbound HTTPS, and nothing else. No socket.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airprompter /var/log/zudocs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
