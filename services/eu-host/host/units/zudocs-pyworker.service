# The Zudocs Python worker on the eu-west host: airprompter-agent (the public Python SDK, pinned by the
# sdk-python/v0.3.0 commit) loads its own release into a separate store. It writes telemetry to the daemon's
# shared spool and follows the Node worker's approved generation. The Agent key is injected from
# airprompterd.env. LiteLLM calls Bedrock with the instance role.
#
#   $ systemctl status zudocs-pyworker
#   $ tail -f /var/log/zudocs/pyworker.log

[Unit]
Description=Zudocs eu-west Python worker (airprompter-agent + LiteLLM, resident)
After=network-online.target airprompterd.service
Wants=network-online.target

[Service]
Type=simple
User=airprompter
Group=airprompter
EnvironmentFile=/etc/airprompter/zudocs.env
EnvironmentFile=-/etc/airprompter/airprompterd.env
Environment=PYTHONUNBUFFERED=1
Environment="ZUDOCS_WORKER_NAME=eu-west python worker"
ExecStart=/opt/zudocs/venv/bin/python /opt/zudocs/pyworker.py
StandardOutput=append:/var/log/zudocs/pyworker.log
StandardError=append:/var/log/zudocs/pyworker.log
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airprompter /var/log/zudocs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
